# Internal team registration. setup/run generates a random code in your local .env.
SUPERHOT_INVITE_CODE=
SUPERHOT_HOST=127.0.0.1
SUPERHOT_PORT=8765
SUPERHOT_SECURE_COOKIE=false
SUPERHOT_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:5173,http://localhost:5173
# Default is SQLite in .runtime. For PostgreSQL, install/create the database first:
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/superhot
# Keep this optional key safe, or back up the generated .runtime/encryption.key.
# SUPERHOT_ENCRYPTION_KEY=
